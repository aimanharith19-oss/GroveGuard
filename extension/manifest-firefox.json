{
  "manifest_version": 2,
  "name": "Groveguard",
  "version": "1.8.3",
  "description": "Blocks ads, trackers, 18+ and dangerous sites with uBlock Origin and EasyList filter lists you choose: network blocking, element hiding and scriptlets. Lists update daily; nothing you browse is sent anywhere.",
  "icons": {
    "48": "icon48.png",
    "96": "icon96.png",
    "128": "icon128.png"
  },
  "permissions": [
    "webNavigation",
    "webRequest",
    "webRequestBlocking",
    "tabs",
    "alarms",
    "scripting",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "bloom.js",
      "adblock.js",
      "scriptlets.js",
      "bg.js"
    ],
    "persistent": true
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "Groveguard",
    "default_icon": {
      "48": "icon48.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "web-protection@groveguard.org",
      "strict_min_version": "113.0"
    },
    "gecko_android": {
      "strict_min_version": "113.0"
    }
  },
  "web_accessible_resources": [
    "adult.html",
    "adult.js",
    "warning.html",
    "warning.js",
    "wp.css",
    "icon48.png"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "cosmetic.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}