{
  "manifest_version": 3,
  "name": "Groveguard",
  "version": "1.7.0",
  "description": "Blocks ads, trackers and malware with uBlock Origin and EasyList filter lists you choose, and warns before dangerous sites. Lists update daily; nothing you browse is sent anywhere.",
  "icons": {
    "48": "icon48.png",
    "96": "icon96.png",
    "128": "icon128.png"
  },
  "minimum_chrome_version": "111",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "webNavigation",
    "tabs",
    "alarms",
    "scripting",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "sw.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Groveguard",
    "default_icon": {
      "48": "icon48.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [
        "adult.html",
        "adult.js",
        "warning.html",
        "warning.js",
        "wp.css",
        "icon48.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}