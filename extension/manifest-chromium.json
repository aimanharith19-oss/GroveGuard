{
  "manifest_version": 2,
  "name": "Groveguard",
  "version": "1.5.0",
  "description": "Blocks ads, trackers and malware with uBlock Origin and EasyList filter lists you choose, and warns before dangerous sites. Lists update daily; nothing you browse is sent anywhere.",
  "icons": {
    "48": "icon48.png",
    "96": "icon96.png",
    "128": "icon128.png"
  },
  "permissions": [
    "webNavigation",
    "webRequest",
    "webRequestBlocking",
    "tabs",
    "alarms",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "bloom.js",
      "adblock.js",
      "bg.js"
    ],
    "persistent": true
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "Groveguard",
    "default_icon": {
      "48": "icon48.png"
    }
  },
  "options_page": "options.html",
  "web_accessible_resources": [
    "adult.html",
    "adult.js",
    "warning.html",
    "warning.js",
    "wp.css",
    "icon48.png"
  ]
}